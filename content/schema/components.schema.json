{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wrenchwise/components.schema.json",
  "title": "Component inventory",
  "description": "The service-relevant components of one engine variant. Identity, dimensions, placement, fitment and procedure are tracked as five independent verification axes, so a part can be correctly identified without its dimensions being known.",
  "type": "object",
  "required": ["engineVariantId", "revision", "units", "summary", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "engineVariantId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "units": { "type": "string", "enum": ["metres"] },
    "frame": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
  },
  "$defs": {
    "evidenceStatus": {
      "type": "string",
      "enum": ["not-established", "not-applicable", "estimated", "mirror-derived", "photographic", "published", "catalog", "measured", "scanned", "reviewed"]
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "system", "parentId", "kind", "quantity", "applicability", "oemPartNumber", "asset", "procedureStepIds", "sourceIds", "verification", "gaps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "system": {
          "type": "string",
          "enum": ["engine-structure", "timing-drive", "accessory-drive", "cooling", "lubrication", "intake", "exhaust", "fuel", "electrical", "body"]
        },
        "parentId": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["part", "assembly", "fastener", "fastener-set", "group"],
          "description": "group marks geometry that stands in for several physical pieces; it is not one part."
        },
        "quantity": {
          "type": "object",
          "required": ["value", "status"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": ["integer", "null"], "minimum": 0 },
            "status": { "$ref": "#/$defs/evidenceStatus" },
            "sourceIds": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        "applicability": {
          "type": "object",
          "required": ["configurationIds", "engineVariantIds"],
          "additionalProperties": false,
          "properties": {
            "configurationIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "engineVariantIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        },
        "oemPartNumber": {
          "type": "object",
          "required": ["value", "status"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": ["string", "null"] },
            "status": { "$ref": "#/$defs/evidenceStatus" },
            "sourceIds": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        "dimensions": {
          "type": "object",
          "required": ["status", "items"],
          "additionalProperties": false,
          "properties": {
            "status": { "$ref": "#/$defs/evidenceStatus" },
            "sourceIds": { "type": "array", "items": { "type": "string" } },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "value", "unit", "method"],
                "additionalProperties": false,
                "properties": {
                  "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
                  "value": { "type": "number" },
                  "unit": { "type": "string", "enum": ["m", "mm", "deg"] },
                  "method": {
                    "type": "string",
                    "enum": ["photo-proportion", "caliper", "tape", "cad", "scan", "published-spec", "catalog-diagram"]
                  },
                  "tolerance": { "type": "number" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "placement": {
          "type": "object",
          "required": ["status", "frame", "position"],
          "additionalProperties": false,
          "properties": {
            "status": { "$ref": "#/$defs/evidenceStatus" },
            "frame": { "type": "string", "enum": ["engine"] },
            "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "axis": { "type": "string", "enum": ["x", "y", "z"] },
            "sourceIds": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        "asset": {
          "type": "object",
          "required": ["layer", "meshIds"],
          "additionalProperties": false,
          "properties": {
            "layer": { "type": "string", "enum": ["core", "access"] },
            "meshIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
          }
        },
        "procedureStepIds": { "type": "array", "items": { "type": "string" } },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "verification": {
          "type": "object",
          "required": ["identity", "dimensions", "placement", "fitment", "procedure"],
          "additionalProperties": false,
          "properties": {
            "identity": { "$ref": "#/$defs/axis" },
            "dimensions": { "$ref": "#/$defs/axis" },
            "placement": { "$ref": "#/$defs/axis" },
            "fitment": { "$ref": "#/$defs/axis" },
            "procedure": { "$ref": "#/$defs/axis" }
          }
        },
        "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "axis": {
      "type": "object",
      "required": ["status", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/evidenceStatus" },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "reviewedBy": { "type": "string" },
        "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    }
  }
}

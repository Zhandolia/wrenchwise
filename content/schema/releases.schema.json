{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wrenchwise/releases.schema.json",
  "title": "Release record",
  "description": "What each release actually contains: model revision, supported configurations, available procedures, evidence status and the gaps that are still open.",
  "type": "object",
  "required": ["current", "releases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "current": { "type": "string", "minLength": 1 },
    "releases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/release" } }
  },
  "$defs": {
    "release": {
      "type": "object",
      "required": ["id", "date", "modelRevision", "configurationIds", "procedureIds", "evidenceStatus", "summary", "assets", "unresolvedGaps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^r[0-9]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "modelRevision": { "type": "integer", "minimum": 1 },
        "configurationIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "procedureIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidenceStatus": {
          "type": "string",
          "enum": ["illustrative", "partially-measured", "measured", "reviewed"],
          "description": "illustrative means no dimension in the release is measured."
        },
        "mechanicalReview": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["none", "in-progress", "complete"] },
            "reviewer": { "type": "string" },
            "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "note": { "type": "string" }
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "role"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "unresolvedGaps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
